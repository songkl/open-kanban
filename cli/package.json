{
  "name": "open-kanban-cli",
  "version": "0.1.0",
  "description": "Open Kanban CLI - command-line client for the Open Kanban board with OAuth 2.1 dynamic registration",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "kanban": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run add-shebang",
    "add-shebang": "echo '#!/usr/bin/env node' | cat - dist/index.js > temp.js && mv temp.js dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e/runner.test.ts",
    "test:unit": "vitest run --exclude 'tests/e2e/**'",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "keywords": [
    "kanban",
    "cli",
    "oauth",
    "oauth2.1",
    "device-flow"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "man",
    "README.md",
    "README_ZH.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songkl/open-kanban.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/songkl/open-kanban/issues"
  },
  "homepage": "https://github.com/songkl/open-kanban#readme"
}
