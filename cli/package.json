{
  "name": "open-kanban-cli",
  "version": "0.1.0",
  "description": "Open Kanban CLI - command-line client for the Open Kanban board with OAuth 2.1 dynamic registration",
  "main": "dist/index.js",
  "type": "module",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run add-shebang",
    "add-shebang": "echo '#!/usr/bin/env node' | cat - dist/index.js > temp.js && mv temp.js dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "keywords": [
    "kanban",
    "cli",
    "oauth",
    "oauth2.1",
    "device-flow"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}